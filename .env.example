NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
BASE_PATH=/
DB_POOL_MAX=10

# Use only the DEV Supabase project's connection string here.
DATABASE_URL=postgresql://postgres.[DEV_PROJECT_REF]:[PASSWORD]@[DEV_POOLER_HOST]:6543/postgres?sslmode=require
SUPABASE_URL=https://[DEV_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[DEV_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[DEV_SERVICE_ROLE_KEY]

SESSION_SECRET=[LONG_RANDOM_DEVELOPMENT_SECRET]

# Synthetic administrator used only in the dedicated DEV environment.
DEV_ADMIN_EMAIL=dev.admin@payroll-portal.invalid
DEV_ADMIN_PASSWORD=[STRONG_LOCAL_DEV_PASSWORD]

# Dedicated Payroll WhatsApp sender. Never expose these values to the browser.
WHATSAPP_ACCESS_TOKEN=[DEV_PAYROLL_WHATSAPP_ACCESS_TOKEN]
WHATSAPP_PHONE_NUMBER_ID=[DEV_PAYROLL_WHATSAPP_PHONE_NUMBER_ID]
WHATSAPP_GRAPH_API_VERSION=[APPROVED_GRAPH_API_VERSION]
# Confirmed current Meta template configuration. Static intentionally blocks sending.
WHATSAPP_PAYSLIP_TEMPLATE_LANGUAGE=en
WHATSAPP_PAYSLIP_URL_BUTTON_INDEX=0
WHATSAPP_PAYSLIP_CTA_TYPE=static
# Set only after Meta changes the CTA to dynamic and confirms its parameter format.
WHATSAPP_PAYSLIP_URL_PARAMETER_MODE=[full_url_OR_token]
