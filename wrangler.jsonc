{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "payroll-portal",
  "main": "worker.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./artifacts/payroll-portal/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/p/*"
    ]
  }
}